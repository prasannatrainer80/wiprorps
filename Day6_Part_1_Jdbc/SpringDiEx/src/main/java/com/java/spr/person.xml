<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

<bean id="personHitasree" class="com.java.spr.Person">
	<property name="id" value="1" />
	<property name="name" value="Hitasree" />
	<property name="jobDetails">
		<bean class="com.java.spr.JobDetails">
			<property name="job" value="Software Engineer" />
			<property name="company" value="Wipro" />
			<property name="location" value="Bangalore" />
		</bean>
	</property>
	<property name="family">
		<bean class="com.java.spr.Family">
			<property name="city" value="Bangalore" />
			<property name="state" value="KA" />
		</bean>
	</property>
</bean>
